{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [

    {
      "source": "/legacy/:path*",
      "destination": "/new/:path*",
      "permanent": true
    },
    {
      "source": "/old-page",
      "destination": "/new-page",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/articles/:slug",
      "permanent": false
    },
    {
      "source": "/external-link",
      "destination": "https://example.com",
      "permanent": false
    },
    
 
    {
      "source": "/proxy/:path*",
      "destination": "https://external-api.com/:path*"
    },
    {
      "source": "/api/:endpoint*",
      "destination": "https://your-backend.com/api/:endpoint*"
    },
    
    
    {
      "source": "/(.*)",
      "dest": "/server.js"
    }
  ]
}